# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production          # local | production
APP_KEY=                    # generated: make first-run
APP_URL=https://example.com # used in links and CSRF; use http://localhost for dev

# ── Database (MariaDB) ────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_DATABASE=minecraftchat
DB_USERNAME=mcuser
DB_PASSWORD=change_me_db

# ── AI / Knowledge base ───────────────────────────────────────────────────────
OPENSEARCH_INDEX=minecraft_docs

# ── Groq LLM inference ────────────────────────────────────────────────────────
# Sign up at console.groq.com → API Keys → Create key
# Verify the model ID in your Groq console under Models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Internal API key ──────────────────────────────────────────────────────────
# Shared secret between Laravel → Python API.
# Generate: openssl rand -hex 32
# Leave blank to disable enforcement (dev only).
INTERNAL_API_KEY=

# ── Cloudflare Turnstile CAPTCHA ──────────────────────────────────────────────
# Create two sites at dash.cloudflare.com → Turnstile:
#   Site 1 — Managed challenge (for login / register forms)
#   Site 2 — Invisible challenge (for the chat send button)
# Leave blank to disable Turnstile (dev/testing only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY_CHAT=
TURNSTILE_SECRET_KEY_CHAT=
