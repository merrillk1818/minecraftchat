# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production          # local | production
APP_KEY=                    # generated: make first-run
APP_URL=https://example.com # used in links and CSRF; use http://localhost for dev

# ── Database (MariaDB) ────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_DATABASE=minecraftchat
DB_USERNAME=mcuser
DB_PASSWORD=change_me_db

# ── AI / Knowledge base ───────────────────────────────────────────────────────
OPENSEARCH_INDEX=minecraft_docs

# ── Groq LLM inference (default) ──────────────────────────────────────────────
# Sign up at console.groq.com → API Keys → Create key
# Verify the model ID in your Groq console under Models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Ollama (optional local LLM) ───────────────────────────────────────────────
# Off by default — the app doesn't call Ollama for anything; Groq above is
# the only inference backend wired up. This just controls the admin
# dashboard's OLLAMA status card, and the container itself is opt-in too:
#   1. Set OLLAMA_ENABLED=true here
#   2. docker compose --profile ollama up -d
#   3. make ollama-pull
# Leave OLLAMA_ENABLED=false (default) to skip running it entirely and save
# the ~1-4 GB RAM it uses.
OLLAMA_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ── Internal API key ──────────────────────────────────────────────────────────
# Shared secret between Laravel → Python API.
# Generate: openssl rand -hex 32
# Leave blank to disable enforcement (dev only).
INTERNAL_API_KEY=

# ── Cloudflare Turnstile CAPTCHA ──────────────────────────────────────────────
# Create two sites at dash.cloudflare.com → Turnstile:
#   Site 1 — Managed challenge (for login / register forms)
#   Site 2 — Invisible challenge (for the chat send button)
# Leave blank to disable Turnstile (dev/testing only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY_CHAT=
TURNSTILE_SECRET_KEY_CHAT=
